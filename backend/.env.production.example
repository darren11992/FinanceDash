# =============================================================================
# Production Environment Configuration — Fly.io Deployment
# =============================================================================
# These variables are set via `fly secrets set` (NOT committed to source control).
# This file documents what needs to be configured for a production deploy.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Production Project)
# -----------------------------------------------------------------------------
# Create a SEPARATE Supabase project for production.
# Found in: Supabase Dashboard → Settings → API Keys
SUPABASE_URL=https://your-prod-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-prod-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-prod-secret-key

# -----------------------------------------------------------------------------
# TrueLayer (Live Credentials)
# -----------------------------------------------------------------------------
TRUELAYER_CLIENT_ID=your-live-truelayer-client-id
TRUELAYER_CLIENT_SECRET=your-live-truelayer-client-secret

# IMPORTANT: Update this to your Fly.io app URL after first deploy.
# Also register this URL in the TrueLayer console under Redirect URIs.
TRUELAYER_REDIRECT_URI=https://penny-api.fly.dev/api/v1/connections/callback
TRUELAYER_ENV=live
TRUELAYER_AUTH_BASE_URL=https://auth.truelayer.com
TRUELAYER_DATA_BASE_URL=https://api.truelayer.com

# -----------------------------------------------------------------------------
# Token Encryption
# -----------------------------------------------------------------------------
# Use the SAME Fernet key as your existing data — changing it will break
# decryption of already-stored TrueLayer tokens.
# If starting fresh, generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRUELAYER_TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Add your Flutter web domain here.
# Native mobile apps (iOS/Android) don't need CORS — they make direct requests.
# Leave empty if you only have native mobile clients.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Sentry — Error Tracking
# -----------------------------------------------------------------------------
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Leave empty to disable Sentry.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
